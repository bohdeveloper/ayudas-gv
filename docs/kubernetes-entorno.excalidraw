    {
      "id": "el0029",
      "type": "text",
      "x": 80.0,
      "y": 1010.0,
      "width": 412.4,
      "height": 210.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1819980298,
      "version": 1,
      "versionNonce": 738639289,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "docker-compose.yml      →  manifiestos YAML k8s/\nservice (compose)       →  Deployment + Service\ncontenedor              →  Pod (1..N contenedores)\nrestart: unless-stopped →  ReplicaSet (autocuracion)\nred bridge + DNS        →  Service ClusterIP + CoreDNS\nports: \"3000:80\"        →  Ingress / NodePort / forward\nvolumes: postgres_data  →  PVC + PersistentVolume\nenvironment:            →  ConfigMap (claro) + Secret\nhealthcheck:            →  readinessProbe / livenessProbe\ndocker compose up -d    →  kubectl apply -f k8s/\n(no existe)             →  replicas / kubectl scale\n(no existe)             →  rolling update + rollback\n(no existe)             →  Namespace (aislar entornos)\n(no existe)             →  Scheduler multi-nodo",
      "originalText": "docker-compose.yml      →  manifiestos YAML k8s/\nservice (compose)       →  Deployment + Service\ncontenedor              →  Pod (1..N contenedores)\nrestart: unless-stopped →  ReplicaSet (autocuracion)\nred bridge + DNS        →  Service ClusterIP + CoreDNS\nports: \"3000:80\"        →  Ingress / NodePort / forward\nvolumes: postgres_data  →  PVC + PersistentVolume\nenvironment:            →  ConfigMap (claro) + Secret\nhealthcheck:            →  readinessProbe / livenessProbe\ndocker compose up -d    →  kubectl apply -f k8s/\n(no existe)             →  replicas / kubectl scale\n(no existe)             →  rolling update + rollback\n(no existe)             →  Namespace (aislar entornos)\n(no existe)             →  Scheduler multi-nodo",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
