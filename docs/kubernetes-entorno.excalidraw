      "text": "00-namespace.yaml        → Namespace ayudas-dev\n10-backend-config.yaml   → ConfigMap + Secret\n20-postgres.yaml         → Deployment + PVC + Service\n30-backend.yaml          → Deployment + Service\n40-frontend.yaml         → Deployment + Service\n50-ingress.yaml          → Ingress",
      "originalText": "00-namespace.yaml        → Namespace ayudas-dev\n10-backend-config.yaml   → ConfigMap + Secret\n20-postgres.yaml         → Deployment + PVC + Service\n30-backend.yaml          → Deployment + Service\n40-frontend.yaml         → Deployment + Service\n50-ingress.yaml          → Ingress",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
